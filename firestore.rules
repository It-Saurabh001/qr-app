rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Authenticated users have full access to their own document and subcollections
    match /users/{userId}/{document=**} {
      allow read, write: if (request.auth != null && request.auth.uid == userId) || request.time < timestamp.date(2026, 12, 31);
    }

    // Authenticated users or active development grace period
    match /{document=**} {
      allow read, write: if request.auth != null || request.time < timestamp.date(2026, 12, 31);
    }
  }
}
